puts "===== HARDWARE ILAs ====="

foreach h [get_hw_ilas -of [current_hw_device]] {
    puts ""
    puts "HW ILA = $h"
    puts "INSTANCE_NAME = [get_property INSTANCE_NAME $h]"
}

puts ""
puts "===== HARDWARE VIOs ====="

foreach v [get_hw_vios -of [current_hw_device]] {
    puts ""
    puts "HW VIO = $v"
    report_property $v
}
