puts "============================================================"
puts "DEBUG CORE AXIS CONNECTIVITY CHECK"
puts "============================================================"

set cores {
    i1/frontend/ila_frontend_wr_inst
    i1/your_ila_data
    i1/hand_mode_inst/vio_handen
    i1/your_ila_pcie_data
    design_1_wrapper/your_pcie_final_ila
    design_1_wrapper/dma1_qdma_app_i/axi_st_module_i/ST_c2h_0/ila_c2h_monitor
}

foreach c $cores {

    puts ""
    puts "=================================================="
    puts "CORE = $c"
    puts "=================================================="

    set cell [get_cells -quiet $c]

    if {[llength $cell] == 0} {
        puts "CELL NOT FOUND"
        continue
    }

    set found 0

    foreach p [get_pins -quiet -of_objects $cell] {

        set leaf [lindex [split $p "/"] end]

        if {[regexp -nocase {(axis|tvalid|tready|tdata|tlast)} $leaf]} {

            set found 1

            puts ""
            puts "PIN = $p"

            set n [get_nets -quiet -of_objects $p]

            if {[llength $n]} {
                puts "NET = $n"
            } else {
                puts "NET = *** UNCONNECTED ***"
            }
        }
    }

    if {!$found} {
        puts "NO AXIS-LIKE TOP LEVEL PINS FOUND"
    }
}
