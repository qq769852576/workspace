set hub_clk [get_pins axi_dbg_hub/aclk]

puts "=== HUB CLK NET ==="
get_nets -of_objects $hub_clk

puts "=== HUB CLK OBJECT ==="
get_clocks -of_objects $hub_clk

puts "=== HUB CLK SOURCE ==="
all_fanin -flat -startpoints_only -to $hub_clk

set hub_rst [get_pins axi_dbg_hub/aresetn]

puts "=== HUB RESET NET ==="
get_nets -of_objects $hub_rst

puts "=== HUB RESET SOURCE ==="
all_fanin -flat -startpoints_only -to $hub_rst
