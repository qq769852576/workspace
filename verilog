assign_bd_address \
    -target_address_space \
    [get_bd_addr_spaces /versal_cips_0/PMC_NOC_AXI_0] \
    [get_bd_addr_segs /axi_dbg_hub_0/S_AXI_DBG_HUB/Mem0] \
    -force

validate_bd_design
save_bd_design


set dbg_slave \
    [get_bd_addr_segs /axi_dbg_hub_0/S_AXI_DBG_HUB/Mem0]

set dbg_master \
    [get_bd_addr_segs -addressing -of_objects $dbg_slave]

foreach s $dbg_master {
    puts "SEG=$s"
    puts "OFFSET=[get_property OFFSET $s]"
    puts "RANGE=[get_property RANGE $s]"
}
