puts ""
puts "============================================================"
puts "STEP 1 : CHECK REQUIRED OBJECTS"
puts "============================================================"

set pmc_space \
    [get_bd_addr_spaces -quiet \
        /versal_cips_0/PMC_NOC_AXI_0]

set dbg_seg \
    [get_bd_addr_segs -quiet \
        /axi_dbg_hub_0/S_AXI_DBG_HUB/Mem0]

if {[llength $pmc_space] == 0} {
    error "ERROR: PMC address space not found"
}

if {[llength $dbg_seg] == 0} {
    error "ERROR: Debug Hub Mem0 segment not found"
}

puts "PMC ADDRESS SPACE:"
puts "  $pmc_space"

puts "DEBUG HUB SEGMENT:"
puts "  $dbg_seg"


