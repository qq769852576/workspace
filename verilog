set pll \
[get_cells u_bypass/u_xpio_drv/xpio/inst/clk_scheme_inst/xpll_pll0_inst]

foreach p [get_pins -of_objects $pll] {

    set leaf [lindex [split $p "/"] end]

    if {[regexp -nocase {(rst|reset|lock|clkin|clkout)} $leaf]} {

        puts ""
        puts "PIN = $p"
        puts "DIR = [get_property DIRECTION $p]"
        puts "NET = [get_nets -quiet -of_objects $p]"
    }
}
