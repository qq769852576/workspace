ila_frontend_wr ila_frontend_wr_inst (
    .clk(clk),

    .probe0(h2c_tvalid_0),        // 1 bit
    .probe1(h2c_tready_0),        // 1 bit
    .probe2(h2c_tlast_0),         // 1 bit
    .probe3(state_r),             // 2 bit
    .probe4(xfer_ctr_r),          // 11 bit
    .probe5(imem_wr_en),          // 1 bit
    .probe6(imem_addr),           // 11 bit
    .probe7(imem_wr_data),        // 64 bit
    .probe8(h2c_tdata_0[63:0])    // 64 bit
);

get_nets -of_objects [get_debug_ports dbg_hub/clk]

get_debug_cores *dbg_hub*

get_nets -of_objects [get_debug_ports -of_objects [get_debug_cores *dbg_hub*] -filter {PORT_NAME == clk}]

get_nets -hier *sys_clk*

get_nets -hier *dbg_hub*

get_nets -of_objects [get_debug_ports axi_dbg_hub/aclk]

get_pins -hier *axi_dbg_hub*/aclk

get_nets -of_objects [get_pins -hier *axi_dbg_hub*/aclk]

get_pins -hier *dbg_hub*

get_cells -hier *dbg_hub*

disconnect_net \
    -net [get_nets core_ddrc_core_clk] \
    [get_pins axi_dbg_hub/aclk]

connect_net \
    -net [get_nets ctrl_clk] \
    [get_pins axi_dbg_hub/aclk]


puts "========================================"
puts "Fixing Versal AXI Debug Hub clock..."
puts "========================================"

set hub_pin [get_pins -hier -quiet *axi_dbg_hub*/aclk]

if {[llength $hub_pin] == 0} {
    error "ERROR: Cannot find axi_dbg_hub/aclk"
}

set old_net [get_nets -quiet -of_objects $hub_pin]
set new_net [get_nets -quiet ctrl_clk]

if {[llength $new_net] == 0} {
    error "ERROR: Cannot find ctrl_clk"
}

puts "Old debug hub clock = $old_net"
puts "New debug hub clock = $new_net"

if {[llength $old_net] > 0} {
    disconnect_net -net $old_net -pinlist $hub_pin
}

connect_net -net $new_net -objects $hub_pin

set check_net [get_nets -quiet -of_objects $hub_pin]

puts "Debug hub clock after reconnect = $check_net"

if {$check_net ne $new_net} {
    error "ERROR: Failed to reconnect AXI Debug Hub clock"
}

puts "AXI Debug Hub clock successfully connected to ctrl_clk"
puts "========================================"

set_property STEPS.OPT_DESIGN.TCL.PRE \
{D:/bender_2802/bender_2802/pre_opt_debug.tcl} \
[get_runs impl_1]

get_property STEPS.OPT_DESIGN.TCL.PRE [get_runs impl_1]
