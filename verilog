puts ""
puts "============================================================"
puts "AXI DEBUG HUB AXIS PORTS"
puts "============================================================"

set hub \
    [get_cells design_1_wrapper/design_1_i/axi_dbg_hub_0]

foreach p [get_pins -quiet -of_objects $hub] {

    set leaf [lindex [split $p "/"] end]

    if {[regexp -nocase {(axis|tvalid|tready|tdata|tlast)} $leaf]} {

        puts ""
        puts "PIN = $p"

        set n [get_nets -quiet -of_objects $p]

        if {[llength $n]} {
            puts "NET = $n"
        } else {
            puts "NET = *** UNCONNECTED ***"
        }
    }
}
