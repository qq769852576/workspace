# ============================================================
# VE2802 / Versal AXI Debug Hub dedicated path
#
# Existing:
#   versal_cips_0
#   proc_sys_reset_1
#   axi_dbg_hub_0
#
# Create if absent:
#   axi_noc_dbg
#
# Goal:
#
# PMC_NOC_AXI_0
#      |
#      v
# axi_noc_dbg/S00_AXI
#      |
#      v
# axi_noc_dbg/M00_AXI
#      |
#      v
# axi_dbg_hub_0/S_AXI
#
# pl0_ref_clk
#      +--> axi_noc_dbg/aclk1
#      +--> axi_dbg_hub_0/aclk
#      +--> proc_sys_reset_1/slowest_sync_clk
#
# pl0_resetn
#      --> proc_sys_reset_1/ext_reset_in
#
# proc_sys_reset_1/peripheral_aresetn
#      --> axi_dbg_hub_0/aresetn
# ============================================================


puts "============================================================"
puts "STEP 0 : Check BD objects"
puts "============================================================"

puts "Current BD: [current_bd_design]"

set cips [get_bd_cells -quiet versal_cips_0]

if {[llength $cips] == 0} {
    error "ERROR: versal_cips_0 not found"
}

if {[llength [get_bd_cells -quiet proc_sys_reset_1]] == 0} {
    error "ERROR: proc_sys_reset_1 not found"
}

if {[llength [get_bd_cells -quiet axi_dbg_hub_0]] == 0} {
    error "ERROR: axi_dbg_hub_0 not found"
}

puts "CIPS VLNV = [get_property VLNV $cips]"


# ============================================================
# STEP 1
# Modify packed PS_PMC_CONFIG
#
# We already have pl0_ref_clk, so DO NOT touch its clock config.
#
# Only enable:
#   PMC -> NoC AXI0
#   one PL reset output
# ============================================================

puts ""
puts "============================================================"
puts "STEP 1 : Update CONFIG.PS_PMC_CONFIG"
puts "============================================================"

set props [list_property $cips]

if {[lsearch -exact $props CONFIG.PS_PMC_CONFIG] < 0} {
    error "ERROR: CONFIG.PS_PMC_CONFIG does not exist on versal_cips_0"
}

set ps_pmc_cfg [get_property CONFIG.PS_PMC_CONFIG $cips]

puts "Original PMC_USE_PMC_NOC_AXI0:"
if {[dict exists $ps_pmc_cfg PMC_USE_PMC_NOC_AXI0]} {
    puts [dict get $ps_pmc_cfg PMC_USE_PMC_NOC_AXI0]
} else {
    puts "<not present>"
}

puts "Original PS_NUM_FABRIC_RESETS:"
if {[dict exists $ps_pmc_cfg PS_NUM_FABRIC_RESETS]} {
    puts [dict get $ps_pmc_cfg PS_NUM_FABRIC_RESETS]
} else {
    puts "<not present>"
}

dict set ps_pmc_cfg PMC_USE_PMC_NOC_AXI0 1
dict set ps_pmc_cfg PS_NUM_FABRIC_RESETS 1

set_property CONFIG.PS_PMC_CONFIG $ps_pmc_cfg $cips

# Some CIPS revisions expose this "applied" switch.
if {[lsearch -exact $props CONFIG.PS_PMC_CONFIG_APPLIED] >= 0} {
    set_property CONFIG.PS_PMC_CONFIG_APPLIED 1 $cips
}

puts "Updated PMC_USE_PMC_NOC_AXI0 = \
[dict get [get_property CONFIG.PS_PMC_CONFIG $cips] PMC_USE_PMC_NOC_AXI0]"

puts "Updated PS_NUM_FABRIC_RESETS = \
[dict get [get_property CONFIG.PS_PMC_CONFIG $cips] PS_NUM_FABRIC_RESETS]"


# ============================================================
# STEP 2
# Check CIPS ports generated by new configuration
# ============================================================

puts ""
puts "============================================================"
puts "STEP 2 : Check required CIPS ports"
puts "============================================================"

foreach p {
    pl0_ref_clk
    pl0_resetn
    pmc_axi_noc_axi0_clk
} {
    set obj [get_bd_pins -quiet versal_cips_0/$p]

    if {[llength $obj] == 0} {
        error "ERROR: missing CIPS pin versal_cips_0/$p"
    } else {
        puts "FOUND PIN: versal_cips_0/$p"
    }
}

if {[llength \
    [get_bd_intf_pins -quiet versal_cips_0/PMC_NOC_AXI_0]] == 0} {

    error "ERROR: missing interface versal_cips_0/PMC_NOC_AXI_0"
}

puts "FOUND INTERFACE: versal_cips_0/PMC_NOC_AXI_0"


# ============================================================
# STEP 3
# Create AXI NoC dedicated to Debug Hub
# ============================================================

puts ""
puts "============================================================"
puts "STEP 3 : Create/configure axi_noc_dbg"
puts "============================================================"

if {[llength [get_bd_cells -quiet axi_noc_dbg]] == 0} {

    create_bd_cell \
        -type ip \
        -vlnv xilinx.com:ip:axi_noc:1.0 \
        axi_noc_dbg

    puts "Created axi_noc_dbg"

} else {

    puts "axi_noc_dbg already exists -- reuse it"
}

set_property -dict [list \
    CONFIG.NUM_CLKS {2} \
] [get_bd_cells axi_noc_dbg]

set_property -dict [list \
    CONFIG.CATEGORY {ps_pmc} \
] [get_bd_intf_pins axi_noc_dbg/S00_AXI]

set_property -dict [list \
    CONFIG.ASSOCIATED_BUSIF {S00_AXI} \
] [get_bd_pins axi_noc_dbg/aclk0]

set_property -dict [list \
    CONFIG.ASSOCIATED_BUSIF {M00_AXI} \
] [get_bd_pins axi_noc_dbg/aclk1]

puts "axi_noc_dbg configured"


# ============================================================
# STEP 4
# Connect PMC -> NoC -> Debug Hub AXI path
# ============================================================

puts ""
puts "============================================================"
puts "STEP 4 : AXI interface connections"
puts "============================================================"

connect_bd_intf_net \
    [get_bd_intf_pins versal_cips_0/PMC_NOC_AXI_0] \
    [get_bd_intf_pins axi_noc_dbg/S00_AXI]

connect_bd_intf_net \
    [get_bd_intf_pins axi_noc_dbg/M00_AXI] \
    [get_bd_intf_pins axi_dbg_hub_0/S_AXI]

puts "PMC_NOC_AXI_0 -> axi_noc_dbg -> axi_dbg_hub_0 connected"


# ============================================================
# STEP 5
# Clock connections
#
# aclk0 = PMC side clock
# aclk1 = PL Debug Hub clock
# ============================================================

puts ""
puts "============================================================"
puts "STEP 5 : Clock connections"
puts "============================================================"

connect_bd_net \
    [get_bd_pins versal_cips_0/pmc_axi_noc_axi0_clk] \
    [get_bd_pins axi_noc_dbg/aclk0]

connect_bd_net \
    [get_bd_pins versal_cips_0/pl0_ref_clk] \
    [get_bd_pins axi_noc_dbg/aclk1]

connect_bd_net \
    [get_bd_pins versal_cips_0/pl0_ref_clk] \
    [get_bd_pins axi_dbg_hub_0/aclk]

connect_bd_net \
    [get_bd_pins versal_cips_0/pl0_ref_clk] \
    [get_bd_pins proc_sys_reset_1/slowest_sync_clk]

puts "Debug Hub now uses pl0_ref_clk"
puts "proc_sys_reset_1 now uses pl0_ref_clk"


# ============================================================
# STEP 6
# Reset connections
# ============================================================

puts ""
puts "============================================================"
puts "STEP 6 : Reset connections"
puts "============================================================"

connect_bd_net \
    [get_bd_pins versal_cips_0/pl0_resetn] \
    [get_bd_pins proc_sys_reset_1/ext_reset_in]

connect_bd_net \
    [get_bd_pins proc_sys_reset_1/peripheral_aresetn] \
    [get_bd_pins axi_dbg_hub_0/aresetn]

puts "pl0_resetn -> proc_sys_reset_1"
puts "peripheral_aresetn -> axi_dbg_hub_0/aresetn"


# ============================================================
# STEP 7
# First validation
# ============================================================

puts ""
puts "============================================================"
puts "STEP 7 : Validate BD"
puts "============================================================"

validate_bd_design


# ============================================================
# STEP 8
# Assign Debug Hub into PMC address space
#
# This is the same address-space method used by AMD's
# official Versal Debug Hub example.
# ============================================================

puts ""
puts "============================================================"
puts "STEP 8 : Address assignment"
puts "============================================================"

set dbg_seg \
    [get_bd_addr_segs -quiet axi_dbg_hub_0/S_AXI_DBG_HUB/Mem0]

if {[llength $dbg_seg] == 0} {

    error "ERROR: Debug Hub address segment S_AXI_DBG_HUB/Mem0 not found"

} else {

    assign_bd_address \
        -target_address_space /versal_cips_0/DATA_PMC \
        $dbg_seg \
        -force

    puts "Debug Hub mapped into /versal_cips_0/DATA_PMC"
}


# ============================================================
# STEP 9
# Final validation + save
# ============================================================

puts ""
puts "============================================================"
puts "STEP 9 : Final validate"
puts "============================================================"

validate_bd_design
save_bd_design


# ============================================================
# STEP 10
# Print actual connections for verification
# ============================================================

puts ""
puts "============================================================"
puts "STEP 10 : Verify resulting BD connections"
puts "============================================================"

puts ""
puts "--- Debug Hub S_AXI ---"
get_bd_intf_nets -of_objects \
    [get_bd_intf_pins axi_dbg_hub_0/S_AXI]

puts ""
puts "--- Debug Hub ACLK ---"
get_bd_nets -of_objects \
    [get_bd_pins axi_dbg_hub_0/aclk]

puts ""
puts "--- Debug Hub ARESETN ---"
get_bd_nets -of_objects \
    [get_bd_pins axi_dbg_hub_0/aresetn]

puts ""
puts "--- proc_sys_reset_1 slowest_sync_clk ---"
get_bd_nets -of_objects \
    [get_bd_pins proc_sys_reset_1/slowest_sync_clk]

puts ""
puts "--- PMC NoC AXI ---"
get_bd_intf_nets -of_objects \
    [get_bd_intf_pins versal_cips_0/PMC_NOC_AXI_0]

puts ""
puts "============================================================"
puts "DONE"
puts "============================================================"
