puts "===== 1. Current project / part ====="
puts "PROJECT = [current_project]"
puts "PART    = [get_property PART [current_project]]"
puts "BD      = [current_bd_design]"

puts ""
puts "===== 2. Search AXI NoC IP definitions ====="
set noc_defs [get_ipdefs -all -quiet *axi_noc*]
puts "AXI_NOC defs = $noc_defs"

puts ""
puts "===== 3. Search ALL NoC-related IP definitions ====="
set all_noc_defs [get_ipdefs -all -quiet *noc*]
foreach ip $all_noc_defs {
    puts $ip
}

puts ""
puts "===== 4. Search AXI Debug Hub definitions ====="
set dbg_defs [get_ipdefs -all -quiet *axi_dbg_hub*]
puts "AXI_DBG_HUB defs = $dbg_defs"

puts ""
puts "===== 5. Search reset IP definitions ====="
set rst_defs [get_ipdefs -all -quiet *proc_sys_reset*]
puts "PROC_SYS_RESET defs = $rst_defs"

puts ""
puts "===== 6. Existing NoC-like BD cells ====="

foreach c [get_bd_cells -hier] {
    set vlnv [get_property -quiet VLNV $c]
    if {[regexp -nocase {noc} $vlnv] || [regexp -nocase {noc} $c]} {
        puts "$c    VLNV=$vlnv"
    }
}

puts ""
puts "===== 7. CIPS debug-related interfaces ====="

foreach x {
    PMC_NOC_AXI_0
    PMC_NOC_AXI_1
} {
    set p [get_bd_intf_pins -quiet versal_cips_0/$x]
    if {[llength $p]} {
        puts "FOUND INTF: $p"
    } else {
        puts "MISSING INTF: versal_cips_0/$x"
    }
}

puts ""
puts "===== 8. CIPS debug-related pins ====="

foreach x {
    pl0_ref_clk
    pl0_resetn
    pmc_axi_noc_axi0_clk
    pmc_axi_noc_axi1_clk
} {
    set p [get_bd_pins -quiet versal_cips_0/$x]
    if {[llength $p]} {
        puts "FOUND PIN: $p"
    } else {
        puts "MISSING PIN: versal_cips_0/$x"
    }
}

puts ""
puts "===== 9. Existing debug/reset cells ====="

foreach c {
    axi_dbg_hub_0
    proc_sys_reset_1
} {
    set obj [get_bd_cells -quiet $c]
    if {[llength $obj]} {
        puts "$c    VLNV=[get_property VLNV $obj]"
    } else {
        puts "$c    NOT FOUND"
    }
}
